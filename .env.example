# API Listening Port
PORT=4100

# production | development. production 会强制 PostgreSQL，并关闭默认开放注册。
REVERIA_ENV=development
# GIN_MODE=release 同样视为生产。

# Database: local-dev default is sqlite. Production API must use postgres.
# Web and desktop clients never connect to the database; they call this API only.
# DATABASE_TYPE: sqlite | postgres
DATABASE_TYPE=sqlite
DATABASE_URL=reveria.db
# Production example:
# DATABASE_TYPE=postgres
# DATABASE_URL=host=127.0.0.1 user=reveria password=secret dbname=reveria port=5432 sslmode=disable

# JWT Secret Key（部分部署脚本也认 JWT_SECRET）
REVERIA_SECRET_KEY=replace-with-a-random-secret-key-32

# 仅非生产可用。生产环境若设为 true 会拒绝启动。
# REVERIA_ENABLE_DEV_LOGIN=true

# 生产环境开放注册时，若要把首位用户升为超管，需显式打开：
# REVERIA_BOOTSTRAP_FIRST_ADMIN=true

# Production Web Origins (comma-separated)
REVERIA_ALLOWED_ORIGINS=http://127.0.0.1:14200

# Comma-separated reverse proxy IP/CIDR list. Leave empty when the API is directly exposed.
# 反代终止 TLS 时请填入，以便正确识别 HTTPS Cookie。
REVERIA_TRUSTED_PROXIES=

# Authentication throttling
REVERIA_LOGIN_LIMIT=20
REVERIA_REGISTER_LIMIT=5

# Optional upload limit in bytes (default 100 MiB)
REVERIA_MAX_UPLOAD_BYTES=104857600
REVERIA_DEFAULT_STORAGE_QUOTA_BYTES=10737418240

# File Upload Directory
REVERIA_STORAGE_DIR=storage/uploads

# Upstream AI Gateway (required before submitting generation tasks)
REVERIA_UPSTREAM_API_URL=
REVERIA_UPSTREAM_API_KEY=
# 仅排障使用，生产不要打开：
# REVERIA_INSECURE_SKIP_TLS=true

# Optional site branding
REVERIA_SITE_TITLE=Reveria
REVERIA_SITE_TAGLINE=创意交付工作台
REVERIA_SITE_DESCRIPTION=面向传媒工作室的 AI 创意生产、无限画布与图像精修平台。
REVERIA_SITE_ANNOUNCEMENT=
# 对外访问根地址，用于 sitemap / canonical，例如 https://studio.example.com
REVERIA_PUBLIC_ORIGIN=

# Next.js 服务端反代 API 地址（网页与 API 分进程部署时需要）
# API_INTERNAL_URL=http://127.0.0.1:4100

# Desktop client cloud API origin (production builds only; wails dev defaults to http://localhost:4100)
VITE_REVERIA_API_BASE=https://api.example.com
