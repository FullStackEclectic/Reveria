# API Listening Port
PORT=4100

# Database Configuration (DATABASE_TYPE: 'sqlite' or 'postgres')
DATABASE_TYPE=sqlite
DATABASE_URL=reveria.db

# JWT Secret Key
REVERIA_SECRET_KEY=replace-with-a-random-secret-key-32

# Production Web Origins (comma-separated)
REVERIA_ALLOWED_ORIGINS=http://127.0.0.1:14200

# Comma-separated reverse proxy IP/CIDR list. Leave empty when the API is directly exposed.
REVERIA_TRUSTED_PROXIES=

# Authentication throttling
REVERIA_LOGIN_LIMIT=20
REVERIA_REGISTER_LIMIT=5

# Optional upload limit in bytes (default 100 MiB)
REVERIA_MAX_UPLOAD_BYTES=104857600
REVERIA_DEFAULT_STORAGE_QUOTA_BYTES=10737418240

# File Upload Directory
REVERIA_STORAGE_DIR=storage/uploads

# Upstream AI Gateway (required before submitting generation tasks)
REVERIA_UPSTREAM_API_URL=
REVERIA_UPSTREAM_API_KEY=

# Optional site branding
REVERIA_SITE_TITLE=Reveria
REVERIA_SITE_ANNOUNCEMENT=

# Desktop client cloud API origin (production builds only; wails dev defaults to http://127.0.0.1:4100)
VITE_REVERIA_API_BASE=https://api.example.com
